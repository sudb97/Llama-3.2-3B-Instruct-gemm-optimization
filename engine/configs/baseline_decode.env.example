# Baseline engine build settings (decode-focused).
# Copy to baseline_decode.env and edit if inspect_onnx.py shows different names/dims.
#
# Source of truth for architecture constants: models/onnx-fp16/config.json
#   num_hidden_layers   = 28   -> past_key_values.{0..27}
#   num_key_value_heads = 8    -> KV cache head count (GQA, not the 24 query heads)
#   head_dim            = 128
#
# ONNX inputs (58 total):
#   input_ids                        : batch_size x sequence_length
#   attention_mask                   : batch_size x total_sequence_length   (= past_sequence_length + sequence_length)
#   past_key_values.{0..27}.key      : batch_size x 8 x past_sequence_length x 128
#   past_key_values.{0..27}.value    : batch_size x 8 x past_sequence_length x 128
#
# ONNX outputs (for reference; trtexec infers these, no shape flags needed):
#   logits                           : batch_size x sequence_length x 128256
#   present.{0..27}.key              : batch_size x 8 x total_sequence_length x 128
#   present.{0..27}.value            : batch_size x 8 x total_sequence_length x 128

# NOTE: the onnx-community pre-export is unusable with TensorRT — every
# variant uses com.microsoft contrib ops (GroupQueryAttention,
# SkipSimplifiedLayerNormalization) that TRT's parser cannot import
# ("Plugin not found"). Export a clean standard-ops graph first:
#   ./engine/export_clean_onnx.sh
# then verify names with:
#   python3 engine/inspect_onnx.py --onnx models/onnx-fp16-clean/model.onnx
ONNX=/workspace/Llama-3.2-3B-Instruct-gemm-optimization/models/onnx-fp16-clean/model.onnx
ENGINE=/workspace/Llama-3.2-3B-Instruct-gemm-optimization/engines/baseline_decode.engine
TIMING_CACHE=/workspace/Llama-3.2-3B-Instruct-gemm-optimization/engine/timing_cache.bin

NUM_LAYERS=28
NUM_KV_HEADS=8
HEAD_DIM=128

# Builds the full trtexec shape string for one (batch, sequence_length,
# past_sequence_length) point: input_ids, attention_mask, position_ids, and
# all 56 past_key_values.{layer}.{key,value} tensors.
#
# HAS_POSITION_IDS: optimum exports include a position_ids input (batch x seq)
# that the onnx-community export did not have. Set to 0 if inspect_onnx.py
# shows the input is absent.
HAS_POSITION_IDS=1

gen_shapes() {
  local batch="$1" seq="$2" past="$3"
  local total=$((past + seq))
  local shapes="input_ids:${batch}x${seq},attention_mask:${batch}x${total}"
  if [[ "$HAS_POSITION_IDS" == "1" ]]; then
    shapes+=",position_ids:${batch}x${seq}"
  fi
  local i
  for ((i = 0; i < NUM_LAYERS; i++)); do
    shapes+=",past_key_values.${i}.key:${batch}x${NUM_KV_HEADS}x${past}x${HEAD_DIM}"
    shapes+=",past_key_values.${i}.value:${batch}x${NUM_KV_HEADS}x${past}x${HEAD_DIM}"
  done
  echo "$shapes"
}

# ── Decode profile ──────────────────────────────────────────────────────────
# sequence_length is always 1 (one new token per decode step). Batch covers
# the project's target M=1..8. past_sequence_length ranges from a cold start
# (0) to a representative mid-generation point (128, used for tactic
# profiling) up to a max supported context (2048).
DECODE_MIN_BATCH=1
DECODE_OPT_BATCH=1
DECODE_MAX_BATCH=8

DECODE_MIN_PAST=0
DECODE_OPT_PAST=128
DECODE_MAX_PAST=2048

MIN_SHAPES=$(gen_shapes "$DECODE_MIN_BATCH" 1 "$DECODE_MIN_PAST")
OPT_SHAPES=$(gen_shapes "$DECODE_OPT_BATCH" 1 "$DECODE_OPT_PAST")
MAX_SHAPES=$(gen_shapes "$DECODE_MAX_BATCH" 1 "$DECODE_MAX_PAST")

# ── Prefill profile (optional second build: ./engine/build_engine.sh prefill) ─
# past_sequence_length is 0 throughout (first full-prompt pass, no cache yet).
# sequence_length spans a short prompt (1) up to a long prompt (2048).
PREFILL_ENGINE=/workspace/Llama-3.2-3B-Instruct-gemm-optimization/engines/baseline_prefill.engine

PREFILL_MIN_BATCH=1
PREFILL_OPT_BATCH=1
PREFILL_MAX_BATCH=1

PREFILL_MIN_SEQ=1
PREFILL_OPT_SEQ=512
PREFILL_MAX_SEQ=2048

PREFILL_MIN_SHAPES=$(gen_shapes "$PREFILL_MIN_BATCH" "$PREFILL_MIN_SEQ" 0)
PREFILL_OPT_SHAPES=$(gen_shapes "$PREFILL_OPT_BATCH" "$PREFILL_OPT_SEQ" 0)
PREFILL_MAX_SHAPES=$(gen_shapes "$PREFILL_MAX_BATCH" "$PREFILL_MAX_SEQ" 0)
