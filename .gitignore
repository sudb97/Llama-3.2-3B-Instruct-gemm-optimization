# Model weights and ONNX external data
models/**/*
!models/**/.gitkeep

# Built TensorRT engines and timing caches
engines/**/*
!engines/.gitkeep
engine/timing_cache.bin
engine/*.cache

# Benchmark and profile outputs
bench/results/**/*
!bench/results/.gitkeep
bench/**/*.json
bench/**/*.csv

# Plugin build artifacts
plugin/build/
plugin/**/*.so

# Kernel build artifacts and compiled binaries
kernels/build/
kernels/**/*.o
kernels/gemv_fp16
kernels/gemv_fp8
kernels/mem_pattern_bench
kernels/mem_pattern_bench_*

# Nsight raw captures (hundreds of MB)
bench/profile/*.qdstrm
bench/profile/*.nsys-rep
bench/profile/*.ncu-rep

# Lock files
engine/*.lock

# Host-specific loop binding
kernels/opt_loop/container.env
kernels/opt_loop/loop.pid
kernels/opt_loop/loop_state.json

# Per-iteration ncu dumps (log is EXPERIMENT_LOG.md)
kernels/opt_loop/runs/**
!kernels/opt_loop/runs/signoff_ecc_off/
!kernels/opt_loop/runs/signoff_ecc_off/**
!kernels/opt_loop/runs/signoff_real_synth/
!kernels/opt_loop/runs/signoff_real_synth/**
kernels/opt_loop/.ncu.lock

# Python
__pycache__/
*.pyc
.venv/

# IDE / OS
.DS_Store
*.swp
